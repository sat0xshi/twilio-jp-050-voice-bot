# Copy to .env and fill in. Never commit .env.
# Values below are placeholders. Do not put a real SID, token, or number in git.

# Twilio Console → Account → API keys & tokens.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Japan 050 National number you bought, E.164 (+8150 and 8 digits).
TWILIO_FROM_NUMBER=+8150XXXXXXXX

# One outbound-test destination, E.164.
# A trial account can only call verified numbers.
OUTBOUND_TO=+81XXXXXXXXXX

# Public origin of this app. No path, no trailing slash.
# Example: https://abcd-12-34-56.ngrok-free.app
PUBLIC_BASE_URL=https://your-tunnel.example

# auto: validate X-Twilio-Signature when TWILIO_AUTH_TOKEN is set.
# Set false only to curl TwiML on localhost before you have a token.
TWILIO_VALIDATE_REQUESTS=auto

STATUS_LOG_PATH=logs/call_status.jsonl
HOST=127.0.0.1
PORT=8000
